---
import CtaLink from "../components/CtaLink.astro";
import SharedPageLayout from "../components/SharedPageLayout.astro";
---

<SharedPageLayout title="Page Not Found | Done Deal Digital" bodyClass="bg-background-dark font-dmsans text-white">
  <main>
    <section class="not-found">
      <div class="not-found__inner">
        <h1 class="not-found__title h1">THAT PAGE DOESN'T EXIST</h1>
        <p class="not-found__lead text--xxl">The link may be outdated or the page may have moved.</p>
        <p class="not-found__copy text--m">Use the homepage or contact page to get back on track.</p>
        <CtaLink href="/" label="GO HOME" size="md" />
      </div>
    </section>
  </main>
</SharedPageLayout>
