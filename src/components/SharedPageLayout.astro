---
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import RetuneOverlay from "./RetuneOverlay";
import "../styles/global.css";

interface Props {
  title: string;
  bodyClass?: string;
  lang?: string;
}

const {
  title,
  bodyClass = "",
  lang = "en",
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JKHF569888"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-JKHF569888');
    </script>
    <link rel="stylesheet" href="/automatic-css/automatic-variables.css" />
    <link rel="stylesheet" href="/automatic-css/automatic.css" />
    <link rel="stylesheet" href="/automatic-css/automatic-tokens.css" />
    <link rel="stylesheet" href="/automatic-css/automatic-custom-css.css" />
    <title>{title}</title>
    <slot name="head" />
    <!-- Pixel Code - https://analytics.travishinton.us/ -->
    <script defer src="https://analytics.travishinton.us/pixel/SMyGg89IUqhLOe5o"></script>
    <!-- END Pixel Code -->
  </head>
  <body class={bodyClass}>
    <SiteHeader />
    <RetuneOverlay client:load />
    <slot />
    <SiteFooter />
  </body>
</html>
