---
import SiteHeader from "./SiteHeader.astro";
import SiteFooter from "./SiteFooter.astro";
import RetuneOverlay from "./RetuneOverlay";
import "../styles/global.css";

interface Props {
  title: string;
  bodyClass?: string;
  lang?: string;
}

const {
  title,
  bodyClass = "",
  lang = "en",
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <link rel="stylesheet" href="/automatic-css/automatic-variables.css" />
    <link rel="stylesheet" href="/automatic-css/automatic.css" />
    <link rel="stylesheet" href="/automatic-css/automatic-tokens.css" />
    <link rel="stylesheet" href="/automatic-css/automatic-custom-css.css" />
    <title>{title}</title>
    <slot name="head" />
    <!-- Pixel Code - https://analytics.travishinton.us/ -->
    <script defer src="https://analytics.travishinton.us/pixel/SMyGg89IUqhLOe5o"></script>
    <!-- END Pixel Code -->
  </head>
  <body class={bodyClass}>
    <SiteHeader />
    <RetuneOverlay client:load />
    <slot />
    <SiteFooter />
  </body>
</html>
